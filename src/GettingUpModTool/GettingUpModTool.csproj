<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GettingUpModTool</AssemblyName>
    <RootNamespace>GettingUpModTool</RootNamespace>
    <Version>0.5.0</Version>
    <InformationalVersion>0.5.0</InformationalVersion>
    <Product>Getting Up Mod Tool</Product>
    <Description>Community asset browser, 3D viewer and exporter for Marc Ecko's Getting Up.</Description>
    <Company>Yhzan95</Company>
    <Authors>Yhzan95</Authors>
    <Copyright>Copyright © 2026 Yhzan95</Copyright>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Resources\Flags\*.png" />
    <Resource Include="Resources\AppIcon.ico" />
  </ItemGroup>
</Project>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GettingUpModTool.TextureBrowserWindow" Icon="Resources/AppIcon.ico"
        Title="Textures" Width="1180" Height="780" MinWidth="940" MinHeight="620" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" ShowInTaskbar="False">
    <Window.Resources>
        </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock x:Name="TextureCountText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="16,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="Textures" FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="ContextText" Text="Sélectionne une texture : l'image se met à jour immédiatement." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="2,0,2,8">
                        <TextBlock Text="Rechercher" FontWeight="SemiBold" Margin="2,0,0,4"/>
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="Tape un nom : head, body, trane, gabe…"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="2,0,2,9">
                        <TextBlock Text="Afficher" FontWeight="SemiBold" Margin="2,0,0,4"/>
                        <ComboBox x:Name="ScopeBox" Style="{StaticResource ReadableScopeCombo}" SelectionChanged="ScopeBox_SelectionChanged">
                            <ComboBoxItem Content="Textures du personnage actuel" Tag="current"/>
                            <ComboBoxItem Content="Textures du dossier du mesh" Tag="folder"/>
                            <ComboBoxItem Content="Toutes les textures du jeu" Tag="all"/>
                        </ComboBox>
                    </StackPanel>

                    <DockPanel Grid.Row="2" Margin="2,0,2,8">
                        <TextBlock Text="Vue" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,8,0"/>
                        <TextBlock x:Name="GalleryStatusText" DockPanel.Dock="Right" Text="Liste" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                        <WrapPanel>
                            <Button Click="ListView_Click" Padding="10,4" Margin="0,0,4,0">☰ Liste</Button>
                            <Button Click="GalleryView_Click" Padding="10,4" Margin="0">▦ Miniatures</Button>
                        </WrapPanel>
                    </DockPanel>

                    <Grid Grid.Row="3">
                        <ListBox x:Name="TextureList" SelectionChanged="TextureList_SelectionChanged" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Right" Background="{StaticResource PillBrush}" CornerRadius="3" Padding="5,2" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding SourceLabel}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="{StaticResource TextStrongBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding DetailLine}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox x:Name="TextureGalleryList" Visibility="Collapsed" SelectionChanged="TextureGalleryList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="{StaticResource ChromeBrush}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Width" Value="214"/>
                                    <Setter Property="Height" Value="168"/>
                                    <Setter Property="Margin" Value="4"/>
                                    <Setter Property="Padding" Value="6"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                                            <Grid>
                                                <TextBlock Text="ST" Foreground="{StaticResource BorderStrongBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Grid><Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="{Binding ThumbnailError}" Foreground="{StaticResource AccentBrush}" Background="{StaticResource CanvasOverlayBrush}" TextWrapping="Wrap" FontSize="10" Margin="6" VerticalAlignment="Bottom"/></Grid>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="2,7,2,0">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextStrongBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SourceLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="7">
                        <DockPanel>
                            <TextBlock x:Name="PreviewModeText" Text="Image entière" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <WrapPanel DockPanel.Dock="Right">
                                <Button Click="FitPreview_Click" Padding="10,5" ToolTip="Ajuste toute l'image dans la fenêtre sans la couper">Ajuster image entière</Button>
                                <Button Click="ActualSizePreview_Click" Padding="10,5" ToolTip="Affiche chaque pixel à sa taille réelle avec barres de défilement">100%</Button>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="10" Background="{StaticResource ChromeBrush}" ClipToBounds="True">
                        
                        <Viewbox x:Name="FitPreviewHost" Stretch="Uniform" Margin="18">
                            <Image x:Name="TexturePreviewImage" Stretch="None" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Viewbox>

                        
                        <ScrollViewer x:Name="ActualPreviewHost" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Background="{StaticResource ChromeBrush}">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image x:Name="TexturePreviewActualImage" Stretch="None" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Grid>
                        </ScrollViewer>

                        <TextBlock x:Name="PreviewMessageText" Text="Choisis une texture dans la liste" Foreground="{StaticResource MutedBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="2" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12">
                        <StackPanel>
                            <TextBlock x:Name="PreviewTitleText" Text="Aucune texture sélectionnée" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PreviewInfoText" Text="" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PreviewPathText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="9" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock x:Name="HintText" Text="Astuce : « Ajuster image entière » montre toujours la texture complète ; 100% permet de vérifier les pixels." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,0,12,0"/>
                <WrapPanel DockPanel.Dock="Right">
                    <Button x:Name="ExportPngButton" Click="ExportPng_Click" IsEnabled="False">⬇ PNG</Button>
                    <Button x:Name="OpenFolderButton" Click="OpenFolder_Click" IsEnabled="False">Afficher dans Explorer</Button>
                    <Button x:Name="UseTextureButton" Click="UseTexture_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}">Charger dans le tool</Button>
                    <Button Click="Close_Click">Fermer</Button>
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
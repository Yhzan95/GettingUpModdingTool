<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GettingUpModTool.PropsBrowserWindow" Icon="Resources/AppIcon.ico"
        Title="Objets" Width="1440" Height="860" MinWidth="1120" MinHeight="680" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" ShowInTaskbar="False">
    <Window.Resources>
        </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock x:Name="PropCountText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="16,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="Bibliothèque d’objets" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Choisis une catégorie, trouve ton objet, puis ouvre-le en 3D ou inspecte ses textures." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="290"/><ColumnDefinition Width="12"/><ColumnDefinition Width="400"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="3,0,0,9"><TextBlock Text="1 · Catégorie" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Filtre la bibliothèque" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/></StackPanel>
                    <ListBox Grid.Row="1" x:Name="PropCategoryList" SelectionChanged="PropCategoryList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontSize="19" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1">
                                        <DockPanel><TextBlock Text="{Binding CountLabel}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontSize="11"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource SectionLabelBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="2,0,2,10">
                        <TextBlock Text="2 · Trouve un objet" FontWeight="SemiBold" FontSize="15" Margin="2,0,0,3"/>
                        <TextBlock Text="Tape un nom ou parcours la liste" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,0,0,6"/>
                        <TextBox x:Name="PropSearchBox" TextChanged="PropSearchBox_TextChanged" ToolTip="Exemple : paintcan, phone, crate, bat, health..." MinHeight="34"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="PropMeshList" SelectionChanged="PropMeshList_SelectionChanged" MouseDoubleClick="PropMeshList_MouseDoubleClick" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DirectoryRelativePath}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,10">
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="3 · Inspecte et ouvre" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PropTitleText" Text="Choisis un objet" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                <TextBlock x:Name="PropInfoText" Text="Ses textures et informations apparaîtront ici." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="LoadPropMeshButton" DockPanel.Dock="Right" Click="LoadPropMesh_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Padding="16,9">Ouvrir en 3D →</Button>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Textures de l'objet" FontWeight="SemiBold" Margin="2,0,0,6"/>
                            <ListBox Grid.Row="1" x:Name="PropTextureList" SelectionChanged="PropTextureList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Right" Background="{StaticResource PillBrush}" CornerRadius="3" Padding="5,2" Margin="8,0,0,0"><TextBlock Text="{Binding SourceLabel}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/></Border>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding DetailLine}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <Border Grid.Column="2" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Viewbox Stretch="Uniform" Margin="18"><Image x:Name="PropTexturePreviewImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"/></Viewbox>
                                <TextBlock x:Name="PropTexturePreviewMessage" Text="Sélectionne une texture" Foreground="{StaticResource Muted2Brush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="9" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock x:Name="PropStatusText" Text="Astuce : double-clique un objet pour l’ouvrir immédiatement en 3D." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,0,12,0"/>
                <WrapPanel DockPanel.Dock="Right">
                    <Button x:Name="ExportPropPngButton" Click="ExportPropPng_Click" IsEnabled="False">Exporter PNG</Button>
                    <Button x:Name="ExportPropObjButton" Click="ExportPropObj_Click" IsEnabled="False">⬇ OBJ</Button>
                    <Button x:Name="ExportPropGltfButton" Click="ExportPropGltf_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}">⬇ Blender / glTF</Button>
                    <Button x:Name="OpenPropFolderButton" Click="OpenPropFolder_Click" IsEnabled="False">Afficher dans Explorer</Button>
                    <Button x:Name="OpenPropTexturesButton" Click="OpenPropTextures_Click" IsEnabled="False">🖼 Toutes ses textures</Button>
                    <Button Click="Close_Click">Fermer</Button>
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>